# =============================================================================
# ShopFlow local stack - environment template (copy to .env if you need to
# override anything; docker compose reads .env automatically for interpolation).
#
# Every value here is a throwaway, credential-free local default. Nothing in
# this file is a secret and nothing here may ever be a real credential.
# Names follow contracts.md §11; the *_PORT values are infra-owned.
# =============================================================================

# -----------------------------------------------------------------------------
# contracts.md §11 - service-to-service configuration INSIDE the compose network
# -----------------------------------------------------------------------------
# These names only resolve on the `shopflow` network. Do not point them at
# localhost: the host-side scripts use the published ports below instead.
INVENTORY_BASE_URL=http://shopflow-inventory:8000
ORDERS_BASE_URL=http://shopflow-orders:8000
PROVIDER_BASE_URL=http://notification-provider-emulator:8000
# Must agree with BROKER_USER/BROKER_PASSWORD/BROKER_VHOST below: a mismatch makes
# the `broker-init` job fail loudly and nothing that uses the broker starts.
BROKER_URL=amqp://shopflow:shopflow@message-broker:5672/
REQUEST_TIMEOUT_SECONDS=5
RELEASE_RETRY_INTERVAL_SECONDS=5

# Per-service DATABASE_URL values are built in docker-compose.yml from the
# single-owner store names below; no service ever receives another service's url.

# -----------------------------------------------------------------------------
# Published host ports (infra-owned)
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
WEB_PORT=3000
WEB_CONTAINER_PORT=80
ORDERS_PORT=8001
INVENTORY_PORT=8002
NOTIFICATIONS_PORT=8003
PROVIDER_PORT=8081
ORDERS_DB_PORT=5433
INVENTORY_DB_PORT=5434
NOTIFICATIONS_DB_PORT=5435
BROKER_AMQP_PORT=5672
BROKER_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# Store and broker defaults (throwaway local values, never real credentials)
# -----------------------------------------------------------------------------
SHOPFLOW_DB_USER=shopflow
SHOPFLOW_DB_PASSWORD=shopflow
ORDERS_DB_NAME=shopflow_orders
INVENTORY_DB_NAME=shopflow_inventory
NOTIFICATIONS_DB_NAME=shopflow_notifications
BROKER_USER=shopflow
BROKER_PASSWORD=shopflow
BROKER_VHOST=/

# -----------------------------------------------------------------------------
# Each service's own migration and seed commands (run inside its own image)
# -----------------------------------------------------------------------------
INVENTORY_MIGRATION_COMMAND=alembic upgrade head
ORDERS_MIGRATION_COMMAND=alembic upgrade head
NOTIFICATIONS_MIGRATION_COMMAND=alembic upgrade head
INVENTORY_SEED_COMMAND=python -m app.seed

# -----------------------------------------------------------------------------
# Browser bundle (Vite bakes the gateway url in at build time, contracts.md §2)
# -----------------------------------------------------------------------------
VITE_GATEWAY_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Host-side convenience for the infra scripts (not consumed by docker compose)
# -----------------------------------------------------------------------------
# Where the scripts reach the public gateway, and where they reach the provider
# emulator's published port. Kept apart from PROVIDER_BASE_URL so sourcing this
# file can never point a host script at an unresolvable service name.
GATEWAY_BASE_URL=http://localhost:8080
SHOPFLOW_PROVIDER_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# Startup gate and network policy
# -----------------------------------------------------------------------------
HEALTH_GATE_TIMEOUT=180
HEALTH_GATE_INTERVAL=2
# Budget for the broker bootstrap job (broker-init) to reach the broker.
BROKER_INIT_TIMEOUT_SECONDS=60
# `true` removes the network's outbound route entirely, but Docker Engine then
# refuses to publish ports (localhost:8080 stops working). For the offline proof
# prefer docker-compose.offline.yml, which runs the smoke test inside the network.
SHOPFLOW_NETWORK_INTERNAL=false

