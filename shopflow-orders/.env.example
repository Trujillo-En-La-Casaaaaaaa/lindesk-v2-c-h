# shopflow-orders configuration (contracts.md §11).
#
# Local Docker defaults only - throwaway, credential-free values. Never commit real
# credentials. The owning service ships this file; the runtime reads the
# environment variables it documents here and nothing else.
#
# In the composed stack (shopflow-infra) the documented §11 values are injected:
#   DATABASE_URL=postgresql://shopflow:shopflow@orders-db:5432/shopflow_orders
#   BROKER_URL=amqp://shopflow:shopflow@message-broker:5672/
#   INVENTORY_BASE_URL=http://shopflow-inventory:8000
# The host defaults below point at the ports shopflow-infra publishes, so the
# service and the integration suite can run outside the compose network.

# The store this service owns and is the only writer of (contracts.md §9).
DATABASE_URL=postgresql://shopflow:shopflow@localhost:5433/shopflow_orders

# The broker the transactional outbox publishes to (contracts.md §8).
BROKER_URL=amqp://shopflow:shopflow@localhost:5672/

# The consumed inventory HTTP API (contracts.md §4).
INVENTORY_BASE_URL=http://localhost:8002

# One inbound request of this service is bounded by this timeout, and so is every
# inventory call it makes while handling that request (contracts.md §11).
REQUEST_TIMEOUT_SECONDS=5

# How often the release reconciler retries an inventory release that is still
# PENDING and an order whose reservation is still ambiguous (contracts.md §11).
RELEASE_RETRY_INTERVAL_SECONDS=5

# HTTP port the service listens on. shopflow-infra publishes it as 8001 -> 8000.
PORT=8000

# Run the outbox publisher and the release reconciler inside the service process.
START_WORKERS=true

# Connection pool tuning (optional; no secrets, sane local defaults).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800

# Outbox relay tuning (optional).
BROKER_EXCHANGE=shopflow.orders
BROKER_CONNECT_TIMEOUT_SECONDS=5
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BACKOFF_SECONDS=30

# Release reconciler tuning (optional). A CREATED order is retried only after this
# grace period, so an in-flight create is never raced by the background relay.
RECONCILER_BATCH_SIZE=50
RESERVATION_GRACE_SECONDS=30
